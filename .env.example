# ---- Telegram ----
# @BotFather -> /newbot yoki /token
BOT_TOKEN=
# Webhook uchun maxfiy so'z (ixtiyoriy, o'zingiz o'ylab toping)
WEBHOOK_SECRET=

# ---- Supabase ----
# Supabase -> Project Settings -> API
SUPABASE_URL=
# service_role kaliti. FAQAT serverda! Hech qachon frontendga chiqarmang.
SUPABASE_SERVICE_KEY=

# ---- Gemini AI ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Admin panel ----
# Kuchli parol qo'ying. Bo'sh bo'lsa server ishga tushmaydi.
ADMIN_LOGIN=
ADMIN_PASSWORD=
# 32+ belgili tasodifiy satr: openssl rand -hex 32
ADMIN_JWT_SECRET=

# ---- Deploy ----
# Railway avtomatik beradi; mahalliyda bo'sh qoldiring (long-polling ishlaydi)
PUBLIC_URL=
PORT=3000

# ---- Biznes sozlamalari ----
DELIVERY_FEE=25000
FREE_DELIVERY_FROM=500000
