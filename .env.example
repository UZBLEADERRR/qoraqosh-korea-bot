# ---- Telegram ----
# @BotFather -> /newbot yoki /token
BOT_TOKEN=
# Webhook uchun maxfiy so'z (ixtiyoriy, o'zingiz o'ylab toping)
WEBHOOK_SECRET=

# ---- Baza ----
# Supabase -> Connect -> Session pooler bo'limidagi ulanish satri.
# Ko'rinishi: postgresql://postgres.<ref>:<PAROL>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Jadvallarni qo'lda yaratish SHART EMAS — server o'zi quradi.
DATABASE_URL=
# Ixtiyoriy: Supabase'dan yuklab olingan CA sertifikat matni (to'liq TLS tekshiruvi uchun)
DATABASE_CA_CERT=

# ---- AI ----
# Ikki yo'l bor. Ikkalasini ham qo'ysangiz OpenRouter asosiy, Google zaxira bo'ladi.

# 1) OpenRouter — bitta kalit bilan Gemini va boshqa modellar
#    https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# 2) To'g'ridan-to'g'ri Google AI Studio
#    https://aistudio.google.com/apikey
#    DIQQAT: poster chizish faqat shu yo'l bilan ishlaydi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- Admin panel ----
# Kuchli parol qo'ying. Bo'sh bo'lsa server ishga tushmaydi.
ADMIN_LOGIN=
ADMIN_PASSWORD=
# 32+ belgili tasodifiy satr: openssl rand -hex 32
ADMIN_JWT_SECRET=
# Telegram orqali admin panelga kira oladigan ID'lar (vergul bilan).
# O'z ID'ingizni @userinfobot aytadi. Keyingi adminlarni panel ichidan qo'shasiz.
ADMIN_TELEGRAM_IDS=

# ---- Deploy ----
# Railway avtomatik beradi; mahalliyda bo'sh qoldiring (long-polling ishlaydi)
PUBLIC_URL=
PORT=3000

# ---- Telegram kanallar (admin paneldan ham sozlanadi) ----
# Bu yerda emas, admin panel -> Sozlamalar -> Telegram kanallar dan qo'ying.
# Botni kanalga ADMIN qilib qo'shish shart, aks holda yozolmaydi.

# ---- Yuk (ixtiyoriy) ----
# Baza ulanish hovuzi. Oshirishdan oldin Supabase limitini tekshiring.
DB_POOL_MAX=12
# Bitta so'rovning eng uzun vaqti (ms) — osilgan so'rov hovuzni band qilmasin
DB_QUERY_TIMEOUT_MS=15000
# Shundan sekin so'rovlar logga yoziladi (ms)
SLOW_QUERY_MS=1000
