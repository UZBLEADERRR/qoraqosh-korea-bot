<?xml version="1.0" encoding="utf-8"?>
<!--
  KiOVO — Trusted Web Activity.

  LauncherActivity www.kiovo.shop/app/ ni Chrome orqali TO'LIQ EKRANDA ochadi.
  Domen app/build.gradle dagi `ilovaDomeni` dan (www SHART).
  Brauzer manzil satri ko'rinmasligi uchun sayt shu ilovani tan olishi
  kerak: www.kiovo.shop/.well-known/assetlinks.json da ilova imzosining
  SHA-256 izi turadi (admin panel → Sozlamalar → Android ilova).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+: buyurtma holati haqidagi bildirishnoma uchun ruxsat.
         So'rov ilova ichida, odam «Bildirishnomalarni yoqish» ni bosganda
         chiqadi — ochilishi bilan emas. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ da Chrome'ni topish uchun shart -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:theme="@style/Theme.KiOVO">

        <meta-data
            android:name="asset_statements"
            android:resource="@string/assetStatements" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="@string/appName"
            android:alwaysRetainTaskState="true"
            android:theme="@style/Theme.KiOVO">

            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://${ilovaDomeni}/app/" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/qizil" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
                android:resource="@color/qizilTungi" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/oq" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/tungiFon" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_DIVIDER_COLOR"
                android:resource="@color/shaffof" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_DIVIDER_COLOR_DARK"
                android:resource="@color/shaffof" />
            <!-- Ochilish ekrani: qizil fonda och yashil logotip -->
            <meta-data android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/splash" />
            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/qizil" />
            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="300" />
            <meta-data android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="shop.kiovo.app.fileprovider" />
            <meta-data android:name="android.support.customtabs.trusted.SCREEN_ORIENTATION"
                android:value="portrait" />
            <!-- Chrome bo'lmasa — oddiy brauzer oynasida (ilova baribir ishlaydi) -->
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="customtabs" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ikonkani bosib turganda: Skaner, Savat, Buyurtmalarim -->
            <meta-data android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- www.kiovo.shop/app/... havolalari ilovada ochiladi -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${ilovaDomeni}"
                    android:pathPrefix="/app" />
            </intent-filter>
        </activity>

        <activity android:name="com.google.androidbrowserhelper.trusted.FocusActivity" />

        <!-- Sayt bildirishnomaga ruxsat so'raganda Android'ning o'z oynasi -->
        <activity android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="shop.kiovo.app.fileprovider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <!-- Bildirishnomalar Chrome nomidan emas, KiOVO nomidan chiqadi
                 (Notification delegation). Kichik belgi — oq tabassum. -->
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/ic_bildirishnoma" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
