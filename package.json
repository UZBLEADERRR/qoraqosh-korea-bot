{
  "name": "kiovo",
  "version": "2.0.0",
  "private": true,
  "description": "KiOVO — Koreya kosmetikasi: Telegram bot + Mini App + admin panel",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node scripts/check.js",
    "migrate": "node scripts/migrate.js",
    "test:bot": "node test/bot-oqimi.mjs",
    "test:ops": "node test/operatsiya.mjs",
    "test:agent": "node test/agent.mjs",
    "test:maslahat": "node test/maslahat.mjs",
    "test:skrinshot": "node test/skrinshot.mjs",
    "test": "npm run test:emu && npm run test:bot && npm run test:ops && npm run test:agent && npm run test:maslahat && npm run test:skrinshot",
    "test:emu": "node test/emu-tarif.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "pg": "^8.13.0"
  }
